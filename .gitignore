# Сборка
build/
.gradle/
build_log.txt

# Stonecutter: по папке на версию игры, внутри развёрнутые исходники и jar.
# Всё пересобирается из src/ — в репозитории это 300+ МБ мусора.
versions/*/build/
versions/*/src/

# Готовые jar и архивы раздачи. Их место в GitHub Releases, а не в дереве:
# иначе каждая сборка — это +16 МБ в историю, навсегда.
release/

# Выгрузки корпуса — качаются скриптами, в репозитории им не место.
# ⚠️ ЗДЕСЬ ЖЕ ЛЕЖАТ ДАМПЫ ИЗ ИГРЫ. Не убирать эту строку:
# выкладывать чужие данные в публичный репозиторий нельзя.
data/

# ⚠️ ДАМП ИЗ ИГРЫ — 18 МБ и растёт. Ников там сейчас нет (мод отсекает их
# при сборе), но это РАБОЧИЕ ДАННЫЕ, а не код: формат меняется, и однажды
# туда попадёт то, чего публиковать нельзя. Пересоздаётся игрой сам.
dump/

# Локальное состояние: конфиг мода и его отчёт. У каждого свои.
config.json
diagnostics.txt

# Старая выкладка словарей — теперь их раздаёт publish.py в облако.
dist/

# ⚠️ РАБОЧИЙ ФАЙЛ ПРОЕКТА, НЕ ДОКУМЕНТАЦИЯ. Внутри — IP боевого сервера,
# описание ЧУЖОГО сервиса, живущего на нём, суммы расходов и разбор ошибок.
# Публиковать это нельзя. Документация для людей лежит в README.md.
CLAUDE.md

# ⚠️ Кэш Python: пересоздаётся сам при каждом запуске инструмента.
# В первом коммите его уехало 84 файла из 305 — больше четверти репозитория,
# и каждый прогон менял бы их, засоряя историю.
__pycache__/
*.pyc
*.pyo

# Локальные настройки инструментов разработки
.claude/settings.local.json

# Среды разработки
.idea/
.vscode/
*.iml
run/

# Копии, снятые перед правкой: имена каждый раз новые, поэтому маска широкая.
# Такие файлы уже уезжали к игрокам внутри jar — см. CLAUDE.md.
*.bak*
*.orig*
*.rej*
*.tmp*
*.old*
*.save*
*~

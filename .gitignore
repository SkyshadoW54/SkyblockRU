# Сборка
build/
.gradle/
build_log.txt

# Stonecutter: по папке на версию игры, внутри развёрнутые исходники и jar.
# Всё пересобирается из src/ — в репозитории это 300+ МБ мусора.
versions/*/build/
versions/*/src/

# Готовые jar и архивы раздачи. Их место в GitHub Releases, а не в дереве:
# иначе каждая сборка — это +16 МБ в историю, навсегда.
release/

# Выгрузки корпуса — качаются скриптами, в репозитории им не место.
# ⚠️ ЗДЕСЬ ЖЕ ЛЕЖАТ ДАМПЫ ИЗ ИГРЫ. Не убирать эту строку:
# выкладывать чужие данные в публичный репозиторий нельзя.
data/

# ⚠️ ДАМП ИЗ ИГРЫ — 18 МБ и растёт. Ников там сейчас нет (мод отсекает их
# при сборе), но это РАБОЧИЕ ДАННЫЕ, а не код: формат меняется, и однажды
# туда попадёт то, чего публиковать нельзя. Пересоздаётся игрой сам.
dump/

# Локальное состояние: конфиг мода и его отчёт. У каждого свои.
config.json
diagnostics.txt

# Старая выкладка словарей — теперь их раздаёт publish.py в облако.
dist/

# ⚠️ РАБОЧИЙ ФАЙЛ ПРОЕКТА, НЕ ДОКУМЕНТАЦИЯ. Внутри — IP боевого сервера,
# описание ЧУЖОГО сервиса, живущего на нём, суммы расходов и разбор ошибок.
# Публиковать это нельзя. Документация для людей лежит в README.md.
CLAUDE.md

# ⚠️ ЛЕТОПИСЬ ТОГО ЖЕ ФАЙЛА, и опасна она ТАК ЖЕ. Отделена 02.09, чтобы
# не читаться в начале каждой сессии; внутри те же ники игроков, адреса
# и суммы. Проверено ДО создания файла: без этой строки он уехал бы
# в публичный репозиторий — записанная грабля, из-за которой однажды
# пришлось переписывать историю git.
HISTORY.md

# ⚠️ ЖУРНАЛ ПРОЕКТА, РАЗНЕСЁННЫЙ ИЗ CLAUDE.md ПО ТЕМАМ (03.10.2026): внутри
# всё то же, из-за чего закрыт сам CLAUDE.md, — ники, адреса, суммы, разбор
# ошибок. Правила по путям для Claude Code — выжимка из этого журнала.
# Проверено ДО создания файлов: без этих строк они уехали бы в публичный git.
/notes/
/.claude/rules/

# ⚠️ Кэш Python: пересоздаётся сам при каждом запуске инструмента.
# В первом коммите его уехало 84 файла из 305 — больше четверти репозитория,
# и каждый прогон менял бы их, засоряя историю.
__pycache__/
*.pyc
*.pyo

# Локальные настройки инструментов разработки
.claude/settings.local.json

# Среды разработки
.idea/
.vscode/
*.iml
run/

# Копии, снятые перед правкой: имена каждый раз новые, поэтому маска широкая.
# Такие файлы уже уезжали к игрокам внутри jar — см. CLAUDE.md.
*.bak*
*.orig*
*.rej*
*.tmp*
*.old*
*.save*
*~

# рабочие логи разовых прогонов — воспроизводятся, в репозиторий не идут
scratch_*.log

# ⚠️ МЕДИА В КОРНЕ: видео, логотипы, скриншоты для постов и Telegram.
# 07.08 их прихватил случайный `git add -A`: видео на 45 МБ (90% репозитория)
# и два скриншота аукциона с ЧУЖИМИ никами продавцов. Сторож ников картинки
# не читает, так что защита одна — не пускать их в git вовсе.
# Шаблоны привязаны к корню: картинки внутри src/ и docs/ они не трогают.
/*.mp4
/*.mov
/*.webm
/*.png
/*.jpg
/*.jpeg
/*.gif
/*.webp
/*.svg

# ⚠️ СЛОВАРИ РЕЖИМА FULL (решение игрока 05.09: режим только на машине
# автора; 11.11: убрать из git). Признак тот же, что у release.py и
# publish.py, — `check_release.is_mode_pack` ("group": "full"). Файлы на
# диске остаются и собираются в jar инстансов; людям их вырезает release.py.
# Свежая копия репозитория собирается и без них: index.json их объявляет,
# загрузчик лишь пожалуется на отсутствующий файл. Новый режимный словарь —
# вписать сюда руками, иначе он уедет в git (сторожа на это пока нет).
/src/main/resources/assets/skyblockru/packs/common/80-vanilla-names.json
/src/main/resources/assets/skyblockru/packs/common/83-vanilla-titles.json
/src/main/resources/assets/skyblockru/packs/ru_ru/01-full-icons.json
/src/main/resources/assets/skyblockru/packs/ru_ru/02-full-names.json
/src/main/resources/assets/skyblockru/packs/ru_ru/03-full-jargon.json
/src/main/resources/assets/skyblockru/packs/ru_ru/04-full-strings.json
/src/main/resources/assets/skyblockru/packs/ru_ru/05-full-rules.json
/src/main/resources/assets/skyblockru/packs/ru_ru/06-full-bonuses.json
/src/main/resources/assets/skyblockru/packs/ru_ru/32-full-nav.json
/src/main/resources/assets/skyblockru/packs/ru_ru/77-sb-enchants.json
/src/main/resources/assets/skyblockru/packs/ru_ru/78-sb-stats.json
/src/main/resources/assets/skyblockru/packs/ru_ru/81-item-names.json
/src/main/resources/assets/skyblockru/packs/ru_ru/82-npc-places.json
/src/main/resources/assets/skyblockru/packs/ru_ru/84-reforges.json
